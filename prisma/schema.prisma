datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES
  QUALITY_CONTROL
  VIEWER
  CUSTOMER_CARE
  CALL_CENTER
}

enum Department {
  WASHING
  IRONING
}

enum Shift {
  SHIFT_1
  SHIFT_2
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ItemStatus {
  HELD
  CLAIMED
  DONATED    // Customer said to give it away rather than come collect it
  DISCARDED  // Customer said to throw it away rather than come collect it
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplaintCategory {
  DAMAGED
  DELAYED
  LOST
  QUALITY
  STAFF
  OTHER
}

// How the customer actually got their held item back, recorded at claim time.
enum CollectionMethod {
  IN_PERSON          // Customer came and picked it up themselves
  DELIVERY           // A delivery person came to collect it on the customer's behalf
  INCLUDED_IN_ORDER  // It was tucked into the customer's next laundry order
}

enum DeadStockStatus {
  IN_STOCK
  GIVEN_OUT
  DONATED    // Customer said to give it away rather than come collect it
  DISCARDED  // Customer said to throw it away rather than come collect it
}

// User-managed list of Dead Stock categories (how an order was packaged/
// handled) — starts with Lalaab/Hanger/Buste+Roog/Kabo, but Admin/Customer
// Care can add more from the UI, so this isn't a fixed enum.
model DeadStockCategoryOption {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id         String      @id @default(uuid())
  fullName   String
  email      String      @unique
  password   String
  role       Role
  branch     String?     // HQ or KM5 (null for Admin)
  department Department? // VIEWER only: scopes them to one department. Null = both.
  status     UserStatus  @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Employee {
  id         String     @id @default(uuid())
  name       String
  branch     String     // HQ or KM5
  department Department
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())

  logs       Log[]
}

// The person (Sales or QC staff) who personally registered a Log — distinct from
// the Employee who did the laundry work. Shared branch logins (e.g. "Sales HQ")
// are used by several people day to day, so this tracks who actually logged it.
model Registrar {
  id        String     @id @default(uuid())
  name      String
  branch    String     // HQ or KM5
  role      Role       // SALES or QUALITY_CONTROL
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  logs      Log[]
}

model Log {
  id              String     @id @default(uuid())
  orderId         Int
  quantity        Int
  date            String     // YYYY-MM-DD
  shift           Shift
  durationMinutes Int?
  department      Department
  branch          String

  assignedBy      String     // Legacy free-text fallback (pre-Registrar-link records)
  staffName       String     // Legacy free-text fallback (pre-Employee-link records)

  employeeId      String?
  employee        Employee?  @relation(fields: [employeeId], references: [id])

  registrarId     String?
  registrar       Registrar? @relation(fields: [registrarId], references: [id])

  createdAt       DateTime   @default(now())

  @@index([orderId, department, branch])
  @@index([employeeId])
  @@index([registrarId])
}

// Customer belongings left behind and held at a branch until claimed —
// Admin sees everything; every other user only sees the items they
// personally logged, not a colleague's (createdById). Claiming one out
// pays the person who handled the handover a flat commission, tracked
// separately from the washing/ironing commission report.
model CustomerItem {
  id               String            @id @default(uuid())
  branch           String            // HQ or KM5
  customerId       String            // ticket/reference number from the paper log
  customerName     String
  phone            String?           // customer's phone number, if collected
  description      String            // item(s) left behind
  date             String            // YYYY-MM-DD, when it was logged
  status           ItemStatus        @default(HELD)
  claimedAt        DateTime?
  createdAt        DateTime          @default(now())

  createdById      String?           // User.id who logged this item
  createdByName    String?           // denormalized for display

  claimedById      String?           // User.id who handed the item back
  claimedByName    String?           // denormalized for display
  collectionMethod CollectionMethod?
  collectionNotes  String?           // free-text note on how/where it was collected

  @@index([branch, status])
  @@index([createdById])
}

// Old, uncollected orders sitting at a branch (a "dead stock" list) — logged
// and given back out by Admin or Customer Care only. Given-out orders record
// how they left, same as CustomerItem's collection method, but carry no
// commission — this is a tracking/report feature, not a paid one.
model DeadStock {
  id               String            @id @default(uuid())
  branch           String            // HQ or KM5
  orderId          String            // raw order reference, e.g. "45327-1/1"
  category         String            // free text, picked from DeadStockCategoryOption
  quantity         Int               @default(1)
  date             String            // YYYY-MM-DD, when it was logged
  status           DeadStockStatus   @default(IN_STOCK)
  createdAt        DateTime          @default(now())

  createdById      String?
  createdByName    String?

  givenOutAt       DateTime?
  givenOutById     String?
  givenOutByName   String?
  givenOutMethod   CollectionMethod?
  givenOutNotes    String?

  @@index([branch, status])
}

// Customer complaints — logged by Admin, Sales, or the dedicated Customer
// Care role, and tracked through to resolution.
model Complaint {
  id             String            @id @default(uuid())
  branch         String            // HQ or KM5
  customerName   String
  phone          String?
  orderId        String?           // free-text reference to the related order, if any
  category       ComplaintCategory @default(OTHER)
  description    String
  status         ComplaintStatus   @default(OPEN)
  resolutionNotes String?
  date           String            // YYYY-MM-DD, when it was logged
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([branch, status])
}